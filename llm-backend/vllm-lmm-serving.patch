+
+import numpy as np
+
+class MultiModalBaseMetrics:
+    def __init__(self):
+        self.preprocessing = 0.0
+        self.vision_encoder_cuda_events: Tuple[torch.cuda.Event] = ()
+        self.language_model_tbt_cuda_events: List[Tuple[torch.cuda.Event]] = {}
+        self.language_model_prefill_cuda_events: Tuple[torch.cuda.Event] = {}
+        self.ttft_minus_preprocessing: Tuple[torch.cuda.Event] = ()
+        self.num_prefills = {}
+        self.num_decodes = {}
+        self.batch_id = -1
+        self.time_in_queue = 0.0
+
+        self.num_vision_tokens: int = 0
+        self.num_text_tokens: int = 0
+        self.output_tokens_generated: int = 0
+        self.total_input_tokens: int = 0
+        self.vllm_before_processing_time: float = 0.0
+        self.vllm_requestbody_processing_time: float = 0.0
+        
+    def get_vision_encoder_times(self):
+        torch.cuda.synchronize()
+        try:
+            start, end = self.vision_encoder_cuda_events
+            return round(start.elapsed_time(end), 2)
+        except: # when there are 0 images
+            return 0
+
+    def language_model_prefill_time(self): # sum preprocessing + vision_encoder + language_model_prefill
+        torch.cuda.synchronize()
+        # for batch_id in self.language_model_prefill_cuda_events:
+        prefill_list = [start.elapsed_time(end) for (start, end) in self.language_model_prefill_cuda_events]
+        return np.sum(prefill_list)
+
+    def language_model_prefill_time_list(self): # sum preprocessing + vision_encoder + language_model_prefill
+        torch.cuda.synchronize()
+        prefill_list = {}
+        for batch_id in self.language_model_prefill_cuda_events:
+            start, end = self.language_model_prefill_cuda_events[batch_id]
+            prefill_list[batch_id] = round(start.elapsed_time(end), 2)
+        return prefill_list
+
+    def language_model_tbt(self):
+        torch.cuda.synchronize()
+        tbt_list = [start.elapsed_time(end) for (start, end) in self.language_model_tbt_cuda_events]
+        return round(np.average(tbt_list), 2)
+
+    def language_model_tbt_list(self):
+        torch.cuda.synchronize()
+        tbt_list = {}
+        for batch_id in self.language_model_tbt_cuda_events:
+            start, end = self.language_model_tbt_cuda_events[batch_id]
+            tbt_list[batch_id] = round(start.elapsed_time(end), 2)
+        return tbt_list
+
+    def get_ttft(self):
+        torch.cuda.synchronize()
+        start, end = self.ttft_minus_preprocessing
+        ttft = self.preprocessing + start.elapsed_time(end)
+
+        return round(ttft, 2)
+
+    def get_num_output_tokens(self):
+        return self.output_tokens_generated
+
+    def get_num_vision_tokens(self):
+        return self.num_vision_tokens
+
+    def get_num_text_tokens(self):
+        return self.num_text_tokens
+
+    def get_total_input_tokens(self):
+        return self.num_text_tokens + self.num_vision_tokens
+    
+class MllamaMetrics(MultiModalBaseMetrics):
