+import logging
+from typing import Any, Dict, List, Optional, Tuple, Union
+# from vllm.metrics.config import MetricStoreConfig
+from vllm.metrics.constants import OperationMetrics
+
+import torch
+import os
+
+def check_enabled(func):
+
+    def wrapper(self, *args, **kwargs):
+        if self.disable:
+            return
+        return func(self, *args, **kwargs)
+
+    return wrapper
+
+logger = logging.getLogger(__name__)
+NORMAL_ATTN_PROFILE_DECODER_LAYER = 20
+CROSS_ATTN_PROFILE_DECODER_LAYER = 18 
+BATCH_ID_STR = "iteration_id"
+
+class MetricsStore:
+
+    def __init__(
+        self,
+        # config: MetricStoreConfig,
+    ):
+        self.disable = True
+        # Disable if we don't have a metric config file or we explicitly disable it
+        # if not config or not config.write_metrics:
+        #     self.disable = True
+        #     logger.info("MetricsStore is disabled")
+        #     return
+        # else:
+        #     logger.info(f"MetricsStore is enabled. Writing metrics to {config.output_dir}")
+        
+        # self.config = config
+        # self.output_dir = config.output_dir
+        # self.model_num_layers = config.model_num_layers
+
+        self.reset()
+
+    @classmethod
+    def get_or_create_instance(
+        cls,
+        # config: Optional[MetricStoreConfig] = None,
+    ):
+        if not hasattr(cls, '_instance'):
+            cls._instance = cls()#config) # this is being called for the first time so create a new instance 
+        return cls._instance
+
+    @classmethod
+    def get_instance(cls):
+        return cls._instance
+
+    # at every model layer, check if profiling needs to be done
+    def is_op_level_profiling_enabled(
+            self,
+            metric_name: Any,
+            layer_id: Optional[int] = None,
+    ) -> bool:
+        if self.disable:
+            return False
+
+        # if metric_name in self.op:
+        if metric_name.value.startswith('cross'):
+            return layer_id == CROSS_ATTN_PROFILE_DECODER_LAYER
+        else:
+            return layer_id == NORMAL_ATTN_PROFILE_DECODER_LAYER
+        return False
+
+
+    def reset(self):
+        self.next_batch_id = 0
+
+        if self.disable:
+            return
+
+        self.op_level_metrics_per_batch_events_prefill: Dict[int, Dict[
+            OperationMetrics, List[Tuple[torch.cuda.Event]]]
+        ] = {}
+        self.op_level_metrics_per_batch_events_decode: Dict[int, Dict[
+            OperationMetrics, List[Tuple[torch.cuda.Event]]]
+        ] = {}
+
+
+    def push_operation_metrics_events(
+        self,
+        metrics_name: OperationMetrics,
+        start_event: torch.cuda.Event,
+        end_event: torch.cuda.Event,
+        is_prefill_stage: bool
+    ):
+        if is_prefill_stage:
+            if self.next_batch_id not in self.op_level_metrics_per_batch_events_prefill:
+                self.op_level_metrics_per_batch_events_prefill[self.next_batch_id] = {}
+            
+            for metric in OperationMetrics:
+                if metric not in self.op_level_metrics_per_batch_events_prefill[self.next_batch_id]:
+                    self.op_level_metrics_per_batch_events_prefill[self.next_batch_id][metric] = []
+            self.op_level_metrics_per_batch_events_prefill[self.next_batch_id][metrics_name].append((start_event, end_event))
+        else:
+            if self.next_batch_id not in self.op_level_metrics_per_batch_events_decode:
+                self.op_level_metrics_per_batch_events_decode[self.next_batch_id] = {}
+            
+            for metric in OperationMetrics:
+                if metric not in self.op_level_metrics_per_batch_events_decode[self.next_batch_id]:
+                    self.op_level_metrics_per_batch_events_decode[self.next_batch_id][metric] = []
+            
+            self.op_level_metrics_per_batch_events_decode[self.next_batch_id][metrics_name].append((start_event, end_event))
+
+    def on_batch_end(
+        self,
+        batch_start_time: float,
+        batch_end_time: float,
+    ) -> None:
+        self.next_batch_id = self.next_batch_id + 1
+
+    def store_op_level_metrics(self, header=None, context=None, output_file = "op_level_timings.csv", append=False):
+
+        torch.cuda.synchronize()
+        all_logged_events = self.op_level_metrics_per_batch_events_prefill[0].keys()
+        if not append:
+            os.makedirs(os.path.dirname(output_file), exist_ok=True)
+            line = f'{header},iteration_id,phase,'
+            
+            for event in all_logged_events:
+                line += f'{event.value},' 
+            line += '\n'
+
+            with open(output_file, 'w') as f:
+                f.write(line)
+
+        with open(output_file, 'a') as f:
+            for iteration_id in self.op_level_metrics_per_batch_events_prefill:
+                
+                line = f"{context},{iteration_id},prefill,"
+                for logged_event in all_logged_events:
+                    try:
+                        start, end = self.op_level_metrics_per_batch_events_prefill[iteration_id][logged_event][0]
+                        
+                        value = round(start.elapsed_time(end), 2)
+                    except:
+                        value = 0.0
+                    line += f'{value},'
+                line += "\n"
+                f.write(line)
+        
+        with open(output_file, 'a') as f:
+            for iteration_id in self.op_level_metrics_per_batch_events_decode:
+                line = f"{context},{iteration_id},decode,"
+                for logged_event in all_logged_events:
+                    try:
+                        start, end = self.op_level_metrics_per_batch_events_decode[iteration_id][logged_event][0]
+                        value = round(start.elapsed_time(end), 2)
+                    except:
+                        value = 0.0
+                    line += f'{value},'
+                line += "\n"
+                f.write(line)
