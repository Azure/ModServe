+        if not len(self.lm_self_attn_times_decode):
+            return 0
+        self_attn = [start.elapsed_time(end) for (start, end) in self.lm_self_attn_times_decode]
+        return round(np.average(self_attn), 2)
+
+    def get_cross_attn_prefill_time(self):
+        torch.cuda.synchronize()
+        try:
+            start, end = self.cross_attention_times_prefill
+            return start.elapsed_time(end)
