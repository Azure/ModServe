+++ b/vllm/metrics/cuda_timer.py
@@ -0,0 +1,119 @@
+from typing import Union, Optional
+
+import torch
+import json
+from vllm.metrics.constants import OperationMetrics, ComponentMetrics
+from vllm.metrics.metrics_store import MetricsStore
+from vllm.attention.backends.abstract import AttentionMetadata
+
+
+class CudaTimer:
+
+    def __init__(
+        self,
+        name: Union[OperationMetrics, ComponentMetrics],
+        layer_id: Optional[int] = None,
+    ):
+        self.disable = True
+        self.name = name
+        self.layer_id = layer_id
+        self.metrics_store = MetricsStore.get_or_create_instance()
+
+        # Finegrained logging will introduce overhead. So provide option to disable
+        self.disable = (name is None) or not self.metrics_store.is_op_level_profiling_enabled(metric_name=self.name, layer_id=layer_id)
+
+        if self.disable:
+            return
+        
+        # Choice of profiler
+        self.use_cuda_events = True
+        if self.use_cuda_events:
+            print(f"Using CUDA events for {self.name}, {self.name.value}, {self.layer_id}")
+
+        self.profiler = torch.profiler.profile(
+            activities=[
+                torch.profiler.ProfilerActivity.CUDA,
+            ],
+            record_shapes=True,
+            profile_memory=True,
+            on_trace_ready=self.trace_ready,
+        )
+        self.start_event = None
+        self.end_event = None
+
+
+    def trace_ready(self, trace):
+        # print trace
+        trace_file = 'trace.json'
+        trace.export_chrome_trace(trace_file)
+
+        if type(self.name) == OperationMetrics:
+            print(f"Operation: {self.name.value}")
+
+        # with open(trace_file, 'r') as f:
+        #     trace_data = json.load(f)
+        #     print(json.dumps(trace_data, indent=2))
+        iscuda = False
+        for e in trace.key_averages():
+            # if cuda_time_total exists, set iscuda = True and return
+            if hasattr(e, 'cuda_time_total'):
+                iscuda = True
+                break
+        if iscuda:
+            total_cuda_time = sum([e.cuda_time_total for e in trace.key_averages()])
+
+            if type(self.name) == OperationMetrics:
+                self.metrics_store.push_operation_metrics(
+                self.name, total_cuda_time * 1e-3,  # convert to ms
+                )
+                print(f"Operation: {self.name.value} Time: {total_cuda_time * 1e-3} ms")
+                
+            elif type(self.name) == ComponentMetrics:
+                self.metrics_store.push_operation_metrics(
+                self.name, total_cuda_time * 1e-3,  # convert to ms
+                )
+            else:
+                raise ValueError(f"Invalid Metric Class {self.name}")
+        else:
+            print(f"No CUDA time for {self.name.value}")
+
+    def __call__(self, attn_metadata: AttentionMetadata): # we will decide if this a prefill_timing or a decode timing
+        self.is_prefill_stage = attn_metadata.num_prefills > 0
+        return self
+
+    
+    def __enter__(self):
+        if self.disable:
+            return
+    
+        if self.use_cuda_events:
+            self.start_event = torch.cuda.Event(enable_timing=True)
+            self.start_event.record()
+        else:
+            self.profiler.__enter__()
+        return self
+
+    def __exit__(self, *args):
+        if self.disable:
+            return
+        
+        if self.use_cuda_events:
+            self.end_event = torch.cuda.Event(enable_timing=True)
+            self.end_event.record()
+
+            if type(self.name) == OperationMetrics:
+                self.metrics_store.push_operation_metrics_events(
+                self.name, self.start_event, self.end_event, self.is_prefill_stage
+            )
+            elif type(self.name) == ComponentMetrics:
+                self.metrics_store.push_prefill_component_metrics_events(
+                self.name, self.start_event, self.end_event
+            )
+            else:
+                raise ValueError(f"Invalid Metric Class {self.name}")
+            
+
+        else:
+            self.profiler.__exit__(*args)
+    
+ 
